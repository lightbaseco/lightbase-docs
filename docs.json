        "pages": [
          "core-concepts/indexing-process",
          "core-concepts/languages",
          "core-concepts/infrastructure"
        ]
      },
      {
        "group": "Core concepts",
        "pages": [
          "core-concepts/counterparties",
          "core-concepts/business-entities"
        ]
      },
      {
        "group": "Data curation",
        "pages": [
          "data-curation/overview",
          "data-curation/databases",
          "data-curation/business-entities",
          "data-curation/counterparties",
