        "pages": [
          "getting-started/installation",
          "getting-started/source-control",
          "getting-started/repositories",
          "getting-started/indexing"
        ]
      },
      {
        "group": "Architecture",
        "pages": [
          "architecture/indexing-process",
          "architecture/languages",
          "architecture/application-detection",
          "architecture/entrypoints",
          "architecture/external-interactions",
          "architecture/infrastructure"
        ]
      },
      {
        "group": "MCP server",
        "pages": [
          "mcp/overview"
        ]
      },
      {
        "group": "Security",
        "pages": [
          "security/analysis-processing",
          "security/code-storage"
        ]
      },
      {
        "group": "Data curation",
        "pages": [
          "data-curation/overview",
          "data-curation/databases",
          "data-curation/business-entities",
          "data-curation/counterparties",
          "data-curation/applications"
